From: hrdl <7808331-hrdl@users.noreply.gitlab.com>
Date: Mon, 7 Nov 2022 09:55:54 +0100
Subject: [rockchip_ebc] Fix bw conversion for prepare_prev_before_a2-logic

---
 drivers/gpu/drm/rockchip/rockchip_ebc.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_ebc.c b/drivers/gpu/drm/rockchip/rockchip_ebc.c
index ad4cd4c..594b9a2 100644
--- a/drivers/gpu/drm/rockchip/rockchip_ebc.c
+++ b/drivers/gpu/drm/rockchip/rockchip_ebc.c
@@ -1057,16 +1057,16 @@ static void rockchip_ebc_refresh(struct rockchip_ebc *ebc,
 				pixel2 = (*sbuf & 0b11110000) >> 4;
 
 				// convert to bw
-				if (pixel1 <= 7)
+				if (pixel1 > 7)
 					pixel1 = 15;
 				else
 					pixel1 = 0;
-				if (pixel2 <= 7)
+				if (pixel2 > 7)
 					pixel2 = 15;
 				else
 					pixel2 = 0;
 
-				*sbuf++ = pixel1 & pixel2 << 4;
+				*sbuf++ = pixel1 | pixel2 << 4;
 			}
 		}
 	}
